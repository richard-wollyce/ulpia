{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleet",
  "version": "0.1.0",
  "identifier": "com.fleet.tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "Fleet",
        "width": 360,
        "height": 420,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "dragDropEnabled": true
      },
      {
        "label": "compose",
        "title": "Fleet",
        "width": 560,
        "height": 300,
        "minWidth": 380,
        "minHeight": 220,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "center": true,
        "url": "compose.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
